// jydRenderer's first programmable shader.
// Inputs: in.position, in.normal, in.texcoord
// Uniforms: mvp, vp, cameraPosition, specularLightDirection,
//           diffuseLightDirection, ambientLightColor

shader CommonTexturedLighting {
    vertex {
        position = transform_point(mvp, in.position);
        normal = in.normal;
        texcoord = in.texcoord;
        worldPosition = in.position;
    }

    fragment {
        let texel = sample(in.texcoord);
        let n = normalize(in.normal);
        let diffuse = clamp(
            dot(diffuseLightDirection, n),
            0.0,
            1.0);
        color = texel * (diffuse * 0.8 + 0.2);
    }
}
